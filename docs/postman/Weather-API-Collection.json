{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Weather API — Open-Meteo",
    "description": "Коллекция для тестирования Open-Meteo API: геокодинг города и прогноз погоды.\n\nИспользуется в проекте weather-forecast-cli.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Геокодинг — поиск города",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Если город найден — сохраняем lat/lon в переменные коллекции",
              "if (pm.response.code === 200) {",
              "    const data = pm.response.json();",
              "    if (data.results && data.results.length > 0) {",
              "        pm.collectionVariables.set('lat', data.results[0].latitude);",
              "        pm.collectionVariables.set('lon', data.results[0].longitude);",
              "        console.log('Сохранено: lat=' + data.results[0].latitude + ', lon=' + data.results[0].longitude);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrlGeo}}/search?name={{city}}&count=1&language=ru&format=json",
          "host": ["{{baseUrlGeo}}"],
          "path": ["search"],
          "query": [
            { "key": "name", "value": "{{city}}" },
            { "key": "count", "value": "1" },
            { "key": "language", "value": "ru" },
            { "key": "format", "value": "json" }
          ]
        },
        "description": "Геокодинг: поиск города по названию. Возвращает координаты (lat, lon) и страну.\n\nПример использования: name=Москва"
      },
      "response": [
        {
          "name": "200 OK — город найден",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlGeo}}/search?name=Москва&count=1&language=ru&format=json",
              "host": ["{{baseUrlGeo}}"],
              "path": ["search"],
