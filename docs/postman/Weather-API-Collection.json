    },
    {
      "name": "2. Прогноз погоды — по координатам",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrlForecast}}/forecast?latitude={{lat}}&longitude={{lon}}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days={{days}}&timezone=auto",
          "host": ["{{baseUrlForecast}}"],
          "path": ["forecast"],
          "query": [
            { "key": "latitude", "value": "{{lat}}" },
            { "key": "longitude", "value": "{{lon}}" },
            { "key": "daily", "value": "temperature_2m_max,temperature_2m_min,precipitation_sum" },
            { "key": "forecast_days", "value": "{{days}}" },
            { "key": "timezone", "value": "auto" }
          ]
        },
        "description": "Прогноз погоды по координатам. Использует {{lat}} и {{lon}}, полученные из запроса геокодинга.\n\nПараметр forecast_days: от 1 до 7."
      },
